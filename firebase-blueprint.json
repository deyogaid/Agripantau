{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["petani", "pembeli", "admin"] },
        "location": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "geminiApiKey": { "type": "string" }
      },
      "required": ["uid", "displayName", "role", "createdAt"]
    },
    "Listing": {
      "title": "Pasar Listing",
      "description": "Commodity listing in the marketplace",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "type": { "type": "string", "enum": ["post", "listing"] },
        "commodity": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "description": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "sold", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" }
      },
      "required": ["userId", "userName", "commodity", "price", "stock", "status", "createdAt"]
    },
    "Like": {
      "title": "Like",
      "description": "A like on a listing",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "timestamp"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment on a listing",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "text", "timestamp"]
    },
    "PriceReport": {
      "title": "Price Report",
      "description": "Crowdsourced price update from the field",
      "type": "object",
      "properties": {
        "commodity": { "type": "string" },
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "marketName": { "type": "string" },
        "location": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "verified": { "type": "boolean" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "photoUrl": { "type": "string" },
        "hasPhoto": { "type": "boolean" },
        "isGpsVerified": { "type": "boolean" }
      },
      "required": ["commodity", "price", "unit", "marketName", "location", "userId", "userName", "timestamp"]
    },
    "PriceReportEvidence": {
      "title": "Price Report Evidence",
      "description": "Large photo data separated from metadata for performance",
      "type": "object",
      "properties": {
        "photoUrl": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["photoUrl", "userId", "timestamp"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Record of a trade between users",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "commodity": { "type": "string" },
        "amount": { "type": "number" },
        "unit": { "type": "string" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] },
        "partner": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "commodity", "amount", "unit", "totalPrice", "status", "timestamp"]
    },
    "Chat": {
      "title": "Chat Room",
      "description": "A conversation between two users",
      "type": "object",
      "properties": {
        "participants": { "type": "array" },
        "participantInfo": { "type": "object" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "productId": { "type": "string" },
        "productName": { "type": "string" }
      },
      "required": ["participants", "lastMessageAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A message item in a chat room",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "senderId", "text", "timestamp"]
    },
    "B2BDemand": {
      "title": "Institutional Buyer Demand",
      "description": "Active demand from institutional buyers (B2B)",
      "type": "object",
      "properties": {
        "buyerName": { "type": "string" },
        "commodity": { "type": "string" },
        "amount": { "type": "string" },
        "price": { "type": "number" },
        "deadline": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["buyerName", "commodity", "amount", "price", "status", "createdAt"]
    },
    "ContractApplication": {
      "title": "Contract Application",
      "description": "Application from a farmer for a B2B demand",
      "type": "object",
      "properties": {
        "demandId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "landSize": { "type": "number" },
        "estimatedYield": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["demandId", "userId", "userName", "status", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/listings/{listingId}": {
      "schema": "Listing",
      "description": "Marketplace listings"
    },
    "/listing_media/{listingId}": {
      "schema": "ListingMedia",
      "description": "High-resolution photos for listings"
    },
    "/listings/{listingId}/likes/{userId}": {
      "schema": "Like",
      "description": "Likes on a listing"
    },
    "/listings/{listingId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments on a listing"
    },
    "/price_reports/{reportId}": {
      "schema": "PriceReport",
      "description": "User reported prices"
    },
    "/price_report_evidence/{reportId}": {
      "schema": "PriceReportEvidence",
      "description": "Evidence photos for price reports"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User transactions"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Conversation threads"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual messages"
    },
    "/b2b_demands/{demandId}": {
      "schema": "B2BDemand",
      "description": "B2B institutional buyer requests"
    },
    "/b2b_applications/{applicationId}": {
      "schema": "ContractApplication",
      "description": "Farmer applications for B2B contracts"
    }
  }
}
