rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers (Phase 3) ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations (Phase 4.1) ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt']) &&
             data.keys().size() <= 12 &&
             data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['petani', 'pembeli', 'admin'] &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
             (!('geminiApiKey' in data) || (data.geminiApiKey is string && data.geminiApiKey.size() <= 200));
    }

    function isValidListing(data) {
      return data.keys().hasAll(['userId', 'userName', 'commodity', 'price', 'stock', 'status', 'createdAt']) &&
             data.keys().size() <= 18 &&
             data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() <= 100 &&
             data.commodity is string && data.commodity.size() <= 150 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.status in ['active', 'sold', 'cancelled'] &&
             (!('type' in data) || data.type in ['post', 'listing']) &&
             (!('likesCount' in data) || data.likesCount is number) &&
             (!('commentsCount' in data) || data.commentsCount is number) &&
             (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 1000)) &&
             (!('hasPhoto' in data) || data.hasPhoto is bool) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
             (!('userAvatar' in data) || (data.userAvatar is string && data.userAvatar.size() <= 500)) &&
             (!('userRating' in data) || (data.userRating is number)) &&
             (!('reviewCount' in data) || (data.reviewCount is number));
    }

    function isValidListingMedia(data) {
      return data.keys().hasAll(['photoUrl', 'userId', 'timestamp']) &&
             data.photoUrl is string &&
             data.userId == request.auth.uid;
    }

    function isValidLike(data) {
      return data.keys().hasAll(['userId', 'timestamp']) &&
             data.userId == request.auth.uid;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['userId', 'userName', 'text', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.text is string && data.text.size() <= 1000;
    }

    function isValidPriceReport(data) {
      return data.keys().hasAll(['commodity', 'price', 'unit', 'marketName', 'location', 'userId', 'userName', 'timestamp', 'status']) &&
             data.keys().size() <= 16 &&
             data.userId == request.auth.uid &&
             data.commodity is string && data.commodity.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.unit is string && data.unit.size() <= 20 &&
             data.marketName is string && data.marketName.size() <= 200 &&
             data.location is string && data.location.size() <= 200 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.status in ['pending', 'verified', 'rejected'] &&
             (!('latitude' in data) || data.latitude == null || data.latitude is number) &&
             (!('longitude' in data) || data.longitude == null || data.longitude is number) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             (!('isGpsVerified' in data) || data.isGpsVerified is bool);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'commodity', 'amount', 'unit', 'totalPrice', 'status', 'timestamp']) &&
             data.keys().size() <= 12 && // Allow for sellerId and phone
             data.userId == request.auth.uid &&
             data.commodity is string && data.commodity.size() <= 50 &&
             data.amount is number && data.amount > 0 &&
             data.unit is string && data.unit.size() <= 20 &&
             data.totalPrice is number && data.totalPrice >= 0 &&
             data.status in ['pending', 'completed', 'cancelled'];
    }

    function isValidChat(data) {
      return data.keys().hasAll(['participants', 'lastMessageAt']) &&
             data.participants is list &&
             request.auth.uid in data.participants;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['chatId', 'senderId', 'text', 'timestamp']) &&
             data.senderId == request.auth.uid &&
             data.text is string && data.text.size() <= 5000;
    }

    function isValidB2BDemand(data) {
      return data.keys().hasAll(['buyerName', 'commodity', 'amount', 'price', 'status', 'createdAt']) &&
             data.keys().size() <= 12 &&
             data.buyerName is string && data.buyerName.size() <= 100 &&
             data.commodity is string && data.commodity.size() <= 150 &&
             data.amount is string && data.amount.size() <= 50 &&
             data.price is number && data.price >= 0 &&
             data.status in ['open', 'closed'] &&
             (!('deadline' in data) || (data.deadline is string && data.deadline.size() <= 50)) &&
             (!('image' in data) || (data.image is string && data.image.size() <= 1000)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000));
    }

    function isValidContractApplication(data) {
      return data.keys().hasAll(['demandId', 'userId', 'userName', 'status', 'timestamp']) &&
             data.keys().size() <= 10 &&
             data.userId == request.auth.uid &&
             data.demandId is string &&
             data.status in ['pending', 'accepted', 'rejected'] &&
             (!('landSize' in data) || data.landSize is number) &&
             (!('estimatedYield' in data) || data.estimatedYield is number);
    }

    // --- Match Rules (Phase 4.4) ---

    match /b2b_demands/{demandId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if (isAdmin() && isValidId(demandId) && isValidB2BDemand(incoming())) || (isSignedIn() && isValidB2BDemand(incoming()));
      allow delete: if isAdmin();
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /b2b_applications/{applicationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn(); 
      allow create: if isSignedIn() && isValidId(applicationId) && isValidContractApplication(incoming()) && incoming().timestamp == request.time;
      allow update: if (isAdmin() && isValidContractApplication(incoming()) && incoming().demandId == existing().demandId && incoming().userId == existing().userId) || (isSignedIn() && existing().userId == request.auth.uid && isValidContractApplication(incoming()));
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid && existing().status == 'pending');
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && 
                      isValidId(userId) &&
                      isValidUser(incoming()) && 
                      incoming().role == existing().role && 
                      incoming().createdAt == existing().createdAt &&
                      incoming().diff(existing()).affectedKeys().hasAny(['displayName', 'photoURL', 'location', 'geminiApiKey']);
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /listings/{listingId} {
      allow get: if isValidId(listingId); 
      allow list: if true; // Public marketplace
      allow create: if isSignedIn() && isValidId(listingId) && isValidListing(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(listingId) && (
        (isOwner(existing().userId) && isValidListing(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt) ||
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasAny(['likesCount', 'commentsCount'])) ||
        isAdmin()
      );
      allow delete: if isValidId(listingId) && (isOwner(existing().userId) || isAdmin());

      match /likes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId) && isValidLike(incoming()) && incoming().timestamp == request.time;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidComment(incoming()) && incoming().timestamp == request.time;
        allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      }
    }

    match /price_reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId);
      allow list: if isSignedIn(); 
      allow create: if isVerified() && isValidId(reportId) && isValidPriceReport(incoming()) && incoming().timestamp == request.time;
      allow update: if isValidId(reportId) && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || (
          request.auth != null && 
          existing().userId == request.auth.uid &&
          isValidPriceReport(incoming()) && 
          incoming().userId == existing().userId &&
          incoming().timestamp == existing().timestamp &&
          incoming().get('verified', false) == existing().get('verified', false)
        )
      );
      allow delete: if isValidId(reportId) && (request.auth != null && (existing().userId == request.auth.uid || exists(/databases/$(database)/documents/admins/$(request.auth.uid))));
    }

    match /price_report_evidence/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId);
      allow create: if isVerified() && isValidId(reportId) && 
                      incoming().keys().hasAll(['photoUrl', 'userId', 'timestamp']) &&
                      incoming().photoUrl is string &&
                      incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /listing_media/{listingId} {
      allow get: if isSignedIn() && isValidId(listingId);
      allow create: if isVerified() && isValidId(listingId) && isValidListingMedia(incoming()) && incoming().timestamp == request.time;
      allow update, delete: if isSignedIn() && isValidId(listingId) && (isOwner(existing().userId) || isAdmin());
    }

    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId) && (request.auth != null && (existing().userId == request.auth.uid || exists(/databases/$(database)/documents/admins/$(request.auth.uid))));
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && isValidId(transactionId) && isValidTransaction(incoming()) && incoming().timestamp == request.time;
      allow update: if isValidId(transactionId) && (request.auth != null && (existing().userId == request.auth.uid || exists(/databases/$(database)/documents/admins/$(request.auth.uid)))) && isValidTransaction(incoming()) && incoming().userId == existing().userId && incoming().timestamp == existing().timestamp;
      allow delete: if exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && isValidId(transactionId);
    }

    match /admins/{adminId} {
      allow get: if request.auth != null && isValidId(adminId);
      allow list: if exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false; 
    }

    match /chats/{chatId} {
      allow get: if request.auth != null && (request.auth.uid in resource.data.participants || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow list: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && isValidChat(incoming()) && incoming().lastMessageAt == request.time;
      allow update: if request.auth != null && (request.auth.uid in existing().participants || exists(/databases/$(database)/documents/admins/$(request.auth.uid))) && isValidChat(incoming()) && incoming().lastMessageAt == request.time;
      
      match /messages/{messageId} {
        allow read: if request.auth != null && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
        allow create: if request.auth != null && isValidMessage(incoming()) && incoming().timestamp == request.time;
      }
    }
  }
}
