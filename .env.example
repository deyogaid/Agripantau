# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase Project URL
VITE_SUPABASE_URL="https://xllugmlyytdrlwmfvtnc.supabase.co"
# SUPABASE_ANON_KEY: Your Supabase Anonymous API Key
VITE_SUPABASE_ANON_KEY=""
# SUPABASE_KEY: Alternative name for Supabase Key
VITE_SUPABASE_KEY=""

# VERCEL_BACKEND_URL: Link to your existing Vercel deployment API
VITE_VERCEL_API_URL=""
# VERCEL_PROJECT_ID: your project ID (configured in Secrets)
VITE_VERCEL_PROJECT_ID="prj_3Xar5tG2ZuOn5F6DSWeEHAvrdHm2"
# Vercel Deploy Hook (Trigger production builds)
VITE_VERCEL_DEPLOY_HOOK="https://api.vercel.com/v1/integrations/deploy/prj_3Xar5tG2ZuOn5F6DSWeEHAvrdHm2/COl4VY6XV3"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
