rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Identity check against /admins collection
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt']) &&
             data.keys().size() <= 7 &&
             data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['petani', 'pembeli', 'admin'] &&
             data.createdAt == request.time;
    }

    function isValidListing(data) {
      return data.keys().hasAll(['userId', 'userName', 'commodity', 'price', 'stock', 'status', 'createdAt']) &&
             data.keys().size() <= 10 &&
             data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() <= 100 &&
             data.commodity is string && data.commodity.size() <= 50 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.status in ['active', 'sold', 'cancelled'] &&
             data.createdAt == request.time;
    }

    function isValidPriceReport(data) {
      return data.keys().hasAll(['commodity', 'price', 'unit', 'marketName', 'location', 'userId', 'userName', 'timestamp']) &&
             data.keys().size() <= 9 &&
             data.userId == request.auth.uid &&
             data.commodity is string && data.commodity.size() <= 50 &&
             data.price is number && data.price >= 0 &&
             data.unit is string && data.unit.size() <= 20 &&
             data.marketName is string && data.marketName.size() <= 100 &&
             data.location is string && data.location.size() <= 100 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.timestamp == request.time;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'commodity', 'amount', 'unit', 'totalPrice', 'status', 'timestamp']) &&
             data.keys().size() <= 8 &&
             data.userId == request.auth.uid &&
             data.commodity is string && data.commodity.size() <= 50 &&
             data.amount is number && data.amount > 0 &&
             data.unit is string && data.unit.size() <= 20 &&
             data.totalPrice is number && data.totalPrice >= 0 &&
             data.status in ['pending', 'completed', 'cancelled'] &&
             data.timestamp == request.time;
    }

    // --- Match Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                      isValidUser(incoming()) && 
                      incoming().role == existing().role && // Users cannot promote themselves
                      incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    match /listings/{listingId} {
      allow get: if true; // Public listings
      allow list: if true;
      allow create: if isSignedIn() && isValidListing(incoming());
      allow update: if isSignedIn() && (
        (isOwner(existing().userId) && isValidListing(incoming()) && incoming().userId == existing().userId) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }

    match /price_reports/{reportId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidPriceReport(incoming());
      allow update: if isAdmin() || (
        isOwner(existing().userId) && 
        isValidPriceReport(incoming()) && 
        incoming().userId == existing().userId &&
        incoming().verified == existing().get('verified', false) // Only admin can change verified
      );
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /transactions/{transactionId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && isValidTransaction(incoming());
      allow update: if (isOwner(resource.data.userId) || isAdmin()) && isValidTransaction(incoming());
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console
    }
  }
}
